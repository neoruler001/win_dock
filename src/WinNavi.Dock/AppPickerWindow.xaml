<Window x:Class="WinNavi.Dock.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="앱 추가 (불러오는 중...)" Width="380" Height="500"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="Filter" Margin="0,0,0,8" TextChanged="Filter_Changed"/>
        <ListBox x:Name="List" Grid.Row="1" DisplayMemberPath="Name"
                 MouseDoubleClick="List_DoubleClick"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="추가" Width="70" Margin="0,0,8,0" IsDefault="True" Click="Add_Click"/>
            <Button Content="취소" Width="70" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
