<Window x:Class="WinNavi.Dock.ItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="항목 편집" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        Topmost="True" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="이름" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,12"/>

        <TextBlock Text="경로" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,12">
            <Button Content="찾아보기..." DockPanel.Dock="Right" Padding="8,2" Margin="8,0,0,0" Click="Browse_Click"/>
            <TextBox x:Name="PathBox"/>
        </DockPanel>

        <TextBlock Text="실행 인수 (옵션)" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="ArgsBox" Margin="0,0,0,4"/>
        <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Foreground="Gray"
                   Text="프로그램 실행 시 전달할 명령줄 인수입니다. 예: --incognito, /path 파일.txt"/>

        <CheckBox x:Name="AdminBox" Content="관리자 권한으로 실행" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="확인" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="취소" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
