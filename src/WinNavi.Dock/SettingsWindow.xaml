<Window x:Class="WinNavi.Dock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNavi 설정" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        Topmost="True" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="모니터" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox x:Name="MonitorCombo" DisplayMemberPath="Label" Margin="0,0,0,16"
                  SelectionChanged="Monitor_Changed"/>

        <TextBlock Text="위치" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <WrapPanel Margin="0,0,0,16">
            <RadioButton x:Name="RbTop" Content="상단" GroupName="Pos" Margin="0,0,16,0" Checked="Position_Checked"/>
            <RadioButton x:Name="RbBottom" Content="하단" GroupName="Pos" Margin="0,0,16,0" Checked="Position_Checked"/>
            <RadioButton x:Name="RbLeft" Content="좌측" GroupName="Pos" Margin="0,0,16,0" Checked="Position_Checked"/>
            <RadioButton x:Name="RbRight" Content="우측" GroupName="Pos" Checked="Position_Checked"/>
        </WrapPanel>

        <DockPanel Margin="0,0,0,6">
            <TextBlock x:Name="OpacityLabel" DockPanel.Dock="Right" Text="60%" Width="40" TextAlignment="Right"/>
            <TextBlock Text="배경 투명도" FontWeight="SemiBold"/>
        </DockPanel>
        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Margin="0,0,0,16"
                ValueChanged="Opacity_Changed"/>

        <DockPanel Margin="0,0,0,6">
            <TextBlock x:Name="SizeLabel" DockPanel.Dock="Right" Text="32 px" Width="50" TextAlignment="Right"/>
            <TextBlock Text="아이콘 크기" FontWeight="SemiBold"/>
        </DockPanel>
        <Slider x:Name="SizeSlider" Minimum="16" Maximum="128" TickFrequency="1" IsSnapToTickEnabled="True"
                SmallChange="1" LargeChange="8" Margin="0,0,0,16" ValueChanged="Size_Changed"/>

        <TextBlock Text="동작" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <CheckBox x:Name="CbAutoHide" Content="자동 숨김 (독 가장자리에 마우스를 올리면 표시)"
                  Margin="0,0,0,4" Click="AutoHide_Click"/>
        <CheckBox x:Name="CbReserve" Content="화면 영역 예약 (다른 창이 독과 겹치지 않음)"
                  Margin="0,0,0,4" Click="Reserve_Click"/>

        <DockPanel Margin="0,8,0,6">
            <TextBlock x:Name="RemoveDistLabel" DockPanel.Dock="Right" Text="150 px" Width="50" TextAlignment="Right"/>
            <TextBlock Text="끌어서 삭제 거리" FontWeight="SemiBold"/>
        </DockPanel>
        <Slider x:Name="RemoveDistSlider" Minimum="50" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True"
                SmallChange="10" LargeChange="50" Margin="0,0,0,4" ValueChanged="RemoveDist_Changed"/>
        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="Gray"
                   Text="고정된 아이콘을 독에서 이 거리만큼 끌어내서 놓으면 삭제됩니다."/>

        <TextBlock Text="백업 / 복원" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="백업..." Padding="12,4" Margin="0,0,8,0" Click="Backup_Click"/>
            <Button Content="복원..." Padding="12,4" Click="Restore_Click"/>
        </StackPanel>
        <TextBlock Margin="0,6,0,16" TextWrapping="Wrap" Foreground="Gray"
                   Text="등록된 아이콘, 구분선, 위치 등 모든 설정을 파일(.json)로 저장하거나 불러옵니다."/>

        <TextBlock Text="구분선" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Button Content="구분선 추가" HorizontalAlignment="Left" Padding="12,4" Click="AddSeparator_Click"/>
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="맨 끝에 선을 추가합니다. 끌어서 위치를 옮기고, 우클릭으로 제거합니다."/>
    </StackPanel>
</Window>
